# Copy this file to ".env".
# Default setup: Ollama -- runs entirely on your Mac, completely free, no API key needed.
# (Install from https://ollama.com/download, then run: ollama pull llama3.1)

LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Only needed if you switch LLM_PROVIDER to "anthropic" or "openai" instead ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Retrieval tuning (optional, sensible defaults already set in config.py) ---
# CHUNK_SIZE_WORDS=180
# CHUNK_OVERLAP_WORDS=40
# TOP_K=4
# SIMILARITY_THRESHOLD=0.35

HOST=127.0.0.1
PORT=8000
